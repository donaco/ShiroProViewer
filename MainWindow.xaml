<Window x:Class="ShiroProViewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="立花山城さんが好き過ぎる！"
        Width="1297"
        Height="814"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded">
    <Grid>
        <TabControl>
            <TabItem Header="ゲーム">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <ToolBar Grid.Row="0">
                        <Button Content="スクリーンショット" Click="ScreenshotButton_Click" />
                        <Separator />
                        <TextBlock x:Name="BrowserStatusText" VerticalAlignment="Center" />
                    </ToolBar>
                    <wv2:WebView2 x:Name="Browser" Grid.Row="1" />
                </Grid>
            </TabItem>
            <TabItem Header="設定">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="24" MaxWidth="520" HorizontalAlignment="Left">
                    <TextBlock Text="表示・操作" FontSize="20" FontWeight="Bold" Margin="0,0,0,16" />
                    <CheckBox x:Name="AlwaysOnTopCheckBox"
                              Content="ウィンドウを最前面に表示する"
                              Checked="AlwaysOnTopCheckBox_Changed"
                              Unchecked="AlwaysOnTopCheckBox_Changed"
                              Margin="0,0,0,20" />
                    <TextBlock Text="ゲーム画面の表示倍率（12段階）" />
                    <ComboBox x:Name="ZoomComboBox" Margin="0,8,0,20" Width="140"
                              HorizontalAlignment="Left" IsEditable="False"
                              ItemStringFormat="{}{0}%"
                              SelectionChanged="ZoomComboBox_SelectionChanged" />
                    <CheckBox x:Name="MutedCheckBox"
                              Content="ゲームの音声をOFFにする"
                              Checked="MutedCheckBox_Changed"
                              Unchecked="MutedCheckBox_Changed"
                              Margin="0,0,0,20" />
                    <TextBlock Text="100%のゲーム表示領域は1275×720です。選択した倍率に合わせてウィンドウのサイズも変更します。設定とブラウザーデータはアプリの Data フォルダーに保存します。"
                               TextWrapping="Wrap" Foreground="Gray" />
                </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
