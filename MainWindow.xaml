<Window x:Class="ShiroProViewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="立花山城さんが好き過ぎる！"
        Icon="/icon.png"
        Width="1297"
        Height="814"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded">
    <Grid>
        <TabControl x:Name="MainTabs">
            <TabControl.Template>
                <ControlTemplate TargetType="TabControl">
                    <Grid KeyboardNavigation.TabNavigation="Local">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TabPanel IsItemsHost="True" KeyboardNavigation.TabIndex="1" />
                            <ToolBar Grid.Column="1" HorizontalAlignment="Right">
                                <Button Content="スクショ撮影" Click="ScreenshotButton_Click" />
                                <Separator />
                                <Button Content="再読込み" Click="ReloadButton_Click" />
                                <Separator />
                                <TextBlock x:Name="BrowserStatusText" VerticalAlignment="Center" Margin="8,0,8,0" />
                            </ToolBar>
                        </Grid>
                        <Border Grid.Row="1" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Background="{TemplateBinding Background}"
                                KeyboardNavigation.TabIndex="2">
                            <ContentPresenter x:Name="PART_SelectedContentHost"
                                              ContentSource="SelectedContent"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                    </Grid>
                </ControlTemplate>
            </TabControl.Template>
            <TabItem Header="ゲーム">
                <wv2:WebView2 x:Name="Browser" />
            </TabItem>
            <TabItem Header="設定">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="24" MaxWidth="520" HorizontalAlignment="Left">
                    <TextBlock Text="表示・操作" FontSize="20" FontWeight="Bold" Margin="0,0,0,16" />
                        <CheckBox x:Name="MutedCheckBox"
                              Content="ゲームの音声をOFFにする"
                              Checked="MutedCheckBox_Changed"
                              Unchecked="MutedCheckBox_Changed"
                              Margin="0,0,0,4" />
                    <CheckBox x:Name="DarkModeCheckBox" Content="ダークモードを使用する"
                              Checked="DarkModeCheckBox_Changed" Unchecked="DarkModeCheckBox_Changed"
                              Margin="0,0,0,4" />                    
                    <CheckBox x:Name="AlwaysOnTopCheckBox"
                              Content="ウィンドウを最前面に表示する"
                              Checked="AlwaysOnTopCheckBox_Changed"
                              Unchecked="AlwaysOnTopCheckBox_Changed"
                              Margin="0,0,0,16" />
                    <TextBlock Text="ゲーム画面の表示倍率（12段階）" />
                    <ComboBox x:Name="ZoomComboBox" Margin="0,8,0,4" Width="140"
                              HorizontalAlignment="Left" IsEditable="False"
                              ItemStringFormat="{}{0}%"
                              SelectionChanged="ZoomComboBox_SelectionChanged" />
                    <TextBlock Text="100%のゲーム表示領域は1275×720です。選択した倍率に合わせてウィンドウのサイズも変更します。設定とブラウザーデータはアプリの Data フォルダーに保存します。"
                               TextWrapping="Wrap" Opacity="0.75"  Margin="0,0,0,16" />
                    <TextBlock Text="スクリーンショットの保存先" />
                        <TextBox x:Name="ScreenshotDirectoryTextBox" Margin="0,8,0,4"
                              Width="280" HorizontalAlignment="Left" 
                              IsReadOnly="True" TextWrapping="Wrap" />
                    <Button Content="保存先フォルダーを選択..." HorizontalAlignment="Left"
                            Margin="0,0,0,4" Click="SelectScreenshotDirectory_Click" />
                    <TextBlock Text="保存先は次回起動時にも復元します。未指定の場合はアプリ内の Screenshots に保存します。"
                               TextWrapping="Wrap" Opacity="0.75" Margin="0,0,0,20" />
                </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
